# CircleScribe local / AWS configuration
#
# Never commit a real Bedrock API key. Copy this file to your preferred local
# environment mechanism and fill secrets outside version control.

AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Production Strands + Bedrock extraction
# AWS_BEARER_TOKEN_BEDROCK=replace-locally-never-commit
STRANDS_MODEL=global.anthropic.claude-sonnet-4-6

# Optional local paths
# CIRCLESCRIBE_RUN_DB=/absolute/path/to/runs.sqlite3
# CIRCLESCRIBE_LOCAL_WHISPER_MODEL=mlx-community/whisper-small

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
